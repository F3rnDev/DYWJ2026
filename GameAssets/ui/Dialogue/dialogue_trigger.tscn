[node name="DialogueTrigger" type="Node3D" unique_id=1049267570]
script = ExtResource("1_j3w0q")
dialogues = Array[String](["Congratulations! You have been selected to participate in our program.", "Your objective is simple: keep the core located at the center of the room stable.", "To do this, you will need to monitor and control several systems. Don't worry, we'll explain everything you need to know.", "First of all, you will need power.", "The power in this room is independent from the rest of the complex and can be generated using the red button located near the door.", "Press the button to generate power.", "But be careful.", "Do not generate too much power.", "If the amount of power exceeds the system's limit, the circuit breaker located next to the panel will trip, cutting off power to the room.", "If that happens, simply reset the circuit breaker.", "On the other hand, be careful not to let the power reach zero.", "When the power runs out completely, the core and the room's systems will begin to destabilize rapidly.", "If this happens, don't panic.", "Generate a small amount of power to reset the circuit breaker.", "Oh, and one last thing...", "Since this room's electrical system isn't exactly... new, the power may drop from time to time.", "When that happens, simply reset the circuit breaker again.", "Now, let's talk about temperature.", "The core cannot get too hot.", "To control the temperature, you will find a machine equipped with a red button.", "When the white square lines up with the red marker, press the button.", "This will bring the core's temperature back to an appropriate level.", "Try to keep the system running properly. Excessive temperatures may compromise the core's stability.", "With the temperature system running, some of the valves may begin to build up pressure.", "Fortunately, solving this is simple.", "You will find two red valves near the system.", "Simply turn one of them to release the pressure.", "Finally, we have upgrades.", "If you want to increase your power generation capacity or expand your battery capacity, you can purchase upgrades through our store.", "Upgrades can be purchased using the room's power.", "Simply exchange a certain amount of power for the desired upgrade.", "The greater your systems' capacity, the easier it will be to keep the core stable.", "That's everything you need to know.", "Keep the power at a safe level.", "Control the temperature.", "Release excess pressure.", "And most importantly...", "Do not let the core become unstable.", "Good luck, volunteer.", "We're counting on you."])

[node name="trigger" type="Area3D" parent="." unique_id=1058900356]

[node name="CollisionShape3D" type="CollisionShape3D" parent="trigger" unique_id=1051283088]
shape = SubResource("BoxShape3D_g4v7s")

[connection signal="body_entered" from="trigger" to="." method="start_dialogue"]
